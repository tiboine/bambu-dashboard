# ─────────────────────────────────────────────────────────────────
#  Bambu Lab Dashboard – systemd-tjeneste
#  Kopiert og tilpasset automatisk av setup.sh (bruker og stier settes der)
#  Hold denne og enheten i setup.sh like.
#  Manuell installasjon:
#    sudo cp bambu-dashboard.service /etc/systemd/system/
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now bambu-dashboard
# ─────────────────────────────────────────────────────────────────
[Unit]
Description=Bambu Lab 3D Print Dashboard
# Vent på nettverk og synkronisert klokke (ellers TLS-feil "certificate is not yet valid")
After=network-online.target msr-timesync.service
Wants=network-online.target msr-timesync.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/bambu-dashboard
ExecStart=/home/pi/bambu-dashboard/.venv/bin/python app.py
Restart=always
RestartSec=5
EnvironmentFile=/home/pi/bambu-dashboard/.env

[Install]
WantedBy=multi-user.target
